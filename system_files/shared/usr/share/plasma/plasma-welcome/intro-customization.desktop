[Desktop Entry]
# Customizes the first page of plasma-welcome, see:
# https://invent.kde.org/plasma/plasma-welcome (README)
# Type is required by the format but ignored by plasma-welcome.
Type=Application
Name=Welcome to Aurora, a stable and low-maintenance desktop that keeps itself up to date.
Icon=distributor-logo
Comment=Aurora is built by the Universal Blue community on top of Fedora Kinoite.
URL=https://getaurora.dev
